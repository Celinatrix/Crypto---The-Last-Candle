# Telegram bot used by the Login Widget (without the @). The site's domain must be
# registered for this bot via @BotFather → /setdomain.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Session cookie written by /api/auth/telegram (see lib/session.ts for the format).
SESSION_COOKIE_NAME=tlc_session
SESSION_SECRET=

# DEV ONLY: serve mock data instead of calling the backend. Ignored in production builds.
# Switch scenarios with ?mock=out|new|fresh|active|soon|warned|kicked|error
NEXT_PUBLIC_DEV_MOCKS=0
