# DEV ONLY: serve mock data instead of calling the backend. Ignored in production builds.
# Switch scenarios with ?mock=new|fresh|active|soon|met|rest|grace|failed|kicked|error
NEXT_PUBLIC_DEV_MOCKS=0

# ---- Daily 07:00 red-folder email (app/api/cron/daily-calendar) ----
# Public URL of this site, used for the "Xem lịch trên trang" button.
SITE_URL=https://your-domain.com
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" — set any long random string.
CRON_SECRET=
# Resend API key and a sender on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="The Last Candle <news@your-domain.com>"
# Optional: replies and "Huỷ đăng ký" requests go here (also used for List-Unsubscribe).
EMAIL_REPLY_TO=
# Backend endpoint returning { "emails": ["a@gmail.com", ...] } of active members.
MEMBERS_EMAILS_URL=https://your-backend/internal/members/emails
INTERNAL_API_KEY=
