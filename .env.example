# DEV ONLY: serve mock data instead of calling the backend. Ignored in production builds.
# Switch scenarios with ?mock=new|fresh|active|soon|met|rest|grace|failed|kicked|error
NEXT_PUBLIC_DEV_MOCKS=0

# ---- Site ----
# Public URL of this site: email buttons, unsubscribe links, allowed Origin for POST requests.
SITE_URL=https://your-domain.com
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" — any long random string.
# Also signs the unsubscribe links (changing it invalidates links in old emails).
CRON_SECRET=

# ---- Supabase (database) ----
# Project URL: Settings → Data API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Secret key (sb_secret_…) or legacy service_role key. Bypasses RLS — server only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- BingX Partner API (read-only key) ----
BINGX_API_KEY=
BINGX_SECRET_KEY=

# ---- Email (Gmail SMTP, about 500 recipients a day) ----
# A Gmail account for the site, with 2-Step Verification on.
GMAIL_USER=
# myaccount.google.com/apppasswords → create one. This is not the account's normal password.
GMAIL_APP_PASSWORD=
# Optional: where replies go.
EMAIL_REPLY_TO=
# Who gets the morning digest of kick reviews waiting for a decision (comma-separated).
ADMIN_EMAIL=

# ---- Bot check (Cloudflare Turnstile) ----
# dash.cloudflare.com → Turnstile → Add widget. Leave both empty to disable (local development).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
